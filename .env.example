# Postgres холболт. Supabase: Project Settings → Database → Connection string →
# "Transaction pooler" (6543 порт). [YOUR-PASSWORD]-г өөрийн DB нууц үгээр солино.
DATABASE_URL=postgres://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Нэг Vercel instance олон хүсэлтийг зэрэг гүйцэтгэдэг (Fluid compute). 1 бол бүх
# хүсэлт нэг холболтыг дараалан хүлээж, тэр нь гацвал instance бүхэлдээ гацна.
DB_POOL_MAX=5

# Багшийн нэвтрэлтийн cookie-г баталгаажуулах түлхүүр. Үүсгэх: openssl rand -hex 32
SESSION_SECRET=

# Supabase Realtime: багшийн самбар шууд шинэчлэгдэнэ. Project Settings → API Keys-ээс.
# Хоосон бол самбар 15 секунд тутам шинэчлэгдэнэ.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
