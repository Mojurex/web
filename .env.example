# Postgres холболт. Supabase: Project Settings → Database → Connection string →
# "Transaction pooler" (6543 порт). [YOUR-PASSWORD]-г өөрийн DB нууц үгээр солино.
DATABASE_URL=postgres://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Vercel дээр 1 байлгана (serverless function бүр нэг холболт).
DB_POOL_MAX=1

# Багшийн нэвтрэлтийн cookie-г баталгаажуулах түлхүүр. Үүсгэх: openssl rand -hex 32
SESSION_SECRET=
